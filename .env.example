# ── Avtomatik (vercel env pull) ────────────────────────────────────────
# DATABASE_URL           Neon Postgres — `vercel integration add neon`
# DATABASE_URL_UNPOOLED  migratsiyalar uchun
# BLOB_READ_WRITE_TOKEN  Vercel Blob — `vercel blob create-store`
# CRON_SECRET            Vercel cron chaqiruvlarini imzolaydi (prod'da avtomatik)

# ── Qo'lda to'ldiriladi ────────────────────────────────────────────────

# @BotFather dan olingan bot tokeni
TELEGRAM_BOT_TOKEN=

# Kanal: @kanal_nomi yoki raqamli id (-100...). Bot kanalga ADMIN bo'lishi shart.
TELEGRAM_CHANNEL_ID=

# Saytga kirish paroli
ADMIN_PASSWORD=

# Sessiya cookie'sini imzolaydi — `openssl rand -base64 32`
AUTH_SECRET=

# Telegram shablonidagi {url} shu manzildan yasaladi
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Lokalda cron endpointini sinash uchun (prod'da Vercel o'zi beradi)
CRON_SECRET=
